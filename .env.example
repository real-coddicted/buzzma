# Root deploy .env — read by every service in docker-compose.yaml (notifications, backend,
# communications, score, configurator, frontend) via env_file: .env. This is the combined set
# for that single shared file; it is not a substitute for each module's own standalone-dev
# template (backend/.env.example, configurator/.env.example, communications/.env.example).
#
# Inside the buzzma-net docker network, services must reach each other by their compose
# service name (e.g. http://configurator:8084), never localhost — localhost inside one
# container never resolves to another container.

# ---------- Shared Postgres (backend + configurator) ----------
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_APP_RUNTIME_ROLE=
FLYWAY_MIGRATOR_USER=
FLYWAY_MIGRATOR_PASSWORD=
DB_FLYWAY_MIGRATOR_ROLE=

# ---------- Shared Redis (backend + notifications) ----------
REDIS_HOST=
REDIS_PORT=

# ---------- Shared JWT secrets (backend issues, communications validates) ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------- backend ----------
GEMINI_API_KEY=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
TURNSTILE_ENABLED=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
RATE_LIMIT_AUTH_CAPACITY=
RATE_LIMIT_AUTH_REFILL_TOKENS=
RATE_LIMIT_AUTH_REFILL_PERIOD=
RATE_LIMIT_AUTH_EXPIRE_AFTER_ACCESS=
RATE_LIMIT_USER_CAPACITY=
RATE_LIMIT_USER_REFILL_TOKENS=
RATE_LIMIT_USER_REFILL_PERIOD=
RATE_LIMIT_USER_EXPIRE_AFTER_ACCESS=

# Must be the score service's compose name, not localhost (localhost:8082 is application.yml's
# default and only works when backend and score run as bare processes on the same host).
SCORE_BASE_URL=http://score:8082

# Config/feature-flag SDK. Same localhost caveat as SCORE_BASE_URL above — must be the
# configurator service's compose name. CONFIG_SDK_ENVIRONMENT must match the `environment`
# tag config entries are seeded under in configurator for this deploy tier.
CONFIG_SDK_API_URL=http://configurator:8084
CONFIG_SDK_ENVIRONMENT=

# ---------- configurator ----------
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Selects which db/migrations/<env> seed folder Flyway applies (defaults to "local" — not
# what you want in a real deploy).
CONFIGURATOR_ENV=

# ---------- communications ----------
PORT=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=
WHATSAPP_GRAPH_BASE_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
